# direnv: this repo's environment while inside it (run `direnv allow` once).
# With Nix: shell.nix (bun, git-subrepo, bin/). Without: just bin/ on PATH.
# To have it in every shell instead, source ./include from your shell rc.
if has nix-shell; then
    watch_file $(find nix -name '*.nix' -o -name '.enabled.json')
    use nix
else
    PATH_add bin
fi
