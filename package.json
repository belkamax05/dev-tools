{
  "name": "@belkamax05/dev-tools",
  "version": "0.1.1",
  "description": "Terminal-UI kit and the Bun/Ink dev apps built on it (giti, agenti, porti, processi, pkgi, bmi, envi, convi, depli, proji, devi)",
  "module": "index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/belkamax05/dev-tools.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "workspaces": [
    "apps/*"
  ],
  "bin": {
    "dev-tools": "bin/dev-tools",
    "devi": "bin/devi",
    "agenti": "bin/agenti",
    "bmi": "bin/bmi",
    "convi": "bin/convi",
    "depli": "bin/depli",
    "envi": "bin/envi",
    "giti": "bin/giti",
    "pkgi": "bin/pkgi",
    "porti": "bin/porti",
    "processi": "bin/processi",
    "proji": "bin/proji"
  },
  "files": [
    "bin",
    "apps",
    "libs",
    "include",
    "tsconfig.json",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "lint": "bun biome check .",
    "format": "bun biome check --write --unsafe .",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "ink": "^7.1.1",
    "jpeg-js": "0.4.4",
    "lowlight": "^3.3.0",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  }
}
