#!/bin/sh
# Source from your shell rc to get dev-tools' commands in every shell.
# Needs bun on PATH - the bin/ shims run on it.

get_this_file_directory() {
    __get_dirname_of_script() {
        # shellcheck disable=SC2128,SC3054
        if [ -n "$BASH_SOURCE" ]; then
            dirname "${BASH_SOURCE[0]}"
        elif [ -n "$ZSH_VERSION" ]; then
            # shellcheck disable=SC2296
            dirname "${(%):-%x}" 2>/dev/null || dirname "$0"
        else
            dirname "$0"
        fi
    }
    (cd "$(__get_dirname_of_script)" && pwd)
}

_dev_tools_root=$(get_this_file_directory)
export PATH="$_dev_tools_root/bin:$PATH"
unset _dev_tools_root
