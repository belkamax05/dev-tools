{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Same convention as apps/giti: @/dev-tools/agenti/* is how an outside
    // consumer (dfs-fe-internal, later) reaches this app's core, and
    // @/dev-tools/* is the lib's own shared code, two levels up.
    "paths": {
      "@/dev-tools/agenti/*": ["./src/*"],
      "@/dev-tools/*": ["../../libs/*"]
    }
  }
}
