[alias]
# Stage all changes and fold them into the last commit without editing the message
amend = "!git giti amend"

branch = "!git giti branch"

# Apply the diff of another branch into the working tree as unstaged changes
branch-copy = "!git giti branch/copy"

# Delete a local branch by name or pick one interactively (prompts to force-delete if not fully merged), then optionally delete its remote counterpart too
branch-delete = "!git giti branch/delete"

# Generate an HTML diff between two branches and open it in the browser
branch-diff = "!git giti branch/diff"

# List all local branches, showing the current branch first
branch-list = "!git giti branch/list"

# Rename a local branch and its remote counterpart (push new name, delete old remote branch, retarget tracking). Pass one name to rename the current branch, or 'old new' to rename any branch
branch-move = "!git giti branch/move"

# Delete a local branch by name or pick one interactively; prompts to force-delete if not fully merged
branch-remove = "!git giti branch/remove"

# Show the current branch and all local branches in the repo
branch-status = "!git giti branch/status"

# Switch to a local branch by name or pick one interactively
branch-switch = "!git giti branch/switch"

# List all local branches with their ahead/behind status relative to origin
branches = "!git giti branches"

# Revert all tracked changes to HEAD — newly-added staged files are deleted, untracked files are left as-is, *.patch files are preserved.
cancel-all = "!git giti cancel-all"

# Discard only working-tree (unstaged) changes; staged files and *.patch files are left untouched
cancel-unstaged = "!git giti cancel-unstaged"

# Delete local branches already merged into the current one, after showing them and asking (--dry-run to preview, --yes to skip the prompt)
cleanup = "!git giti cleanup"

# Commit with interactive TUI for message and flags; TUI is skipped when a message or any flag is provided
commit = "!git giti commit"

# Show which local branches share a common ancestor with the current branch, ranked by closeness
diverged-from = "!git giti diverged-from"

# Push to origin without verification (--no-verify -u origin)
fast-push = "!git giti fast-push"

# Run a raw git command, bypassing the giti wrappers — e.g. `giti git status`
git = "!git giti git"

# Print the full commit hash of HEAD
hash = "!git giti hash"

# Show a summary of the current repo state: branch, commit hashes, and dirty status
me = "!git giti me"

mega = "!git giti mega"

# Collect the branches, worktrees, refs and cloned history all three mechanisms abandon in .git (--dry-run to preview)
mega-clean = "!git giti mega/clean"

# Commit uncommitted changes across every submodule, subrepo and subtree, and then this repository (--no-self, -m <msg>)
mega-commit = "!git giti mega/commit"

# Show what this repository and every vendored copy have that their upstreams do not (--stat, --no-self)
mega-diff = "!git giti mega/diff"

# List this repository and everything vendored into it — subrepos, submodules and subtrees, grouped, offline
mega-list = "!git giti mega/list"

# Bring this repository and every subrepo, submodule and subtree up to date, skipping the ones already current (--no-self)
mega-pull = "!git giti mega/pull"

# Push every subrepo, submodule and subtree upstream and then this repository, refusing the pushes that would fail (--no-self)
mega-push = "!git giti mega/push"

# Show this repository and every subrepo, submodule and subtree against their real upstreams (--no-fetch, --no-self)
mega-status = "!git giti mega/status"

# Apply a .patch file — changes land as unstaged working-tree edits. Pick interactively if no name is given.
patch-apply = "!git giti patch-apply"

# Cancel all tracked changes (revert to HEAD), then apply a .patch file. Newly-added staged files are deleted; untracked files are left as-is; *.patch files are preserved.
patch-apply-unsafe = "!git giti patch-apply-unsafe"

# Save all tracked changes (staged + unstaged) to a .patch file. Untracked files are excluded — git add them first if needed.
patch-save = "!git giti patch-save"

# Print the commit history as an ASCII branch graph
print-graph = "!git giti print-graph"

# Pull with interactive TUI showing incoming commits and conflict strategy options; TUI is skipped when any flag is provided
pull = "!git giti pull"

# Push with interactive TUI for flags and upstream info; TUI is skipped when any flag is provided
push = "!git giti push"

# Pretty-print repository status: branch, staged/modified/untracked files, stash, and recent commits
status = "!git giti status"

submodule = "!git giti submodule"

# Remove cloned history left in .git/modules by submodules that are no longer declared (--dry-run to preview)
submodule-clean = "!git giti submodule/clean"

# Show what the vendored copy of a submodule has that its pinned upstream commit does not
submodule-diff = "!git giti submodule/diff"

# List the git submodules of this repository — offline, one line each
submodule-list = "!git giti submodule/list"

# Update every submodule (or the named ones) that actually moved upstream, skipping the current
submodule-pull = "!git giti submodule/pull"

# Push a submodule’s own commits upstream, refusing up front on dirty, unchanged or behind
submodule-push = "!git giti submodule/push"

# Show each submodule against its real upstream — fetches first, so "behind" is a fact not a stale ref
submodule-status = "!git giti submodule/status"

subrepo = "!git giti subrepo"

# Remove the branches, worktrees, refs and .git/tmp files git-subrepo leaves behind after a run (--dry-run to preview)
subrepo-clean = "!git giti subrepo/clean"

# Show what the vendored copy of a subrepo has that its pinned upstream commit does not
subrepo-diff = "!git giti subrepo/diff"

# Install git-subrepo if this machine does not already have it
subrepo-install = "!git giti subrepo/install"

# List the subrepos vendored into this repository — offline, one line each
subrepo-list = "!git giti subrepo/list"

# Pull every subrepo (or the named ones) that actually moved upstream, skipping the ones already current
subrepo-pull = "!git giti subrepo/pull"

# Push a subrepo upstream, refusing up front on the three things that make git-subrepo fail half-way
subrepo-push = "!git giti subrepo/push"

# Show each subrepo against its real upstream — fetches first, so "behind" is a fact not a stale ref
subrepo-status = "!git giti subrepo/status"

subtree = "!git giti subtree"

# Remove the per-subtree fetch refs giti’s own status checks leave behind (--dry-run to preview)
subtree-clean = "!git giti subtree/clean"

# Show what the vendored copy of a subtree has that its pinned upstream commit does not
subtree-diff = "!git giti subtree/diff"

# List the git subtree directories of this repository — offline, one line each
subtree-list = "!git giti subtree/list"

# Merge each subtree’s upstream in, skipping the ones already current (--remote=/--branch= when git subtree did not record one)
subtree-pull = "!git giti subtree/pull"

# Push a subtree’s prefix upstream, refusing up front on dirty, unchanged or behind
subtree-push = "!git giti subtree/push"

# Show each subtree against its real upstream — fetches first, so "behind" is a fact not a stale ref
subtree-status = "!git giti subtree/status"

# Switch branches with interactive TUI — search local & remote branches, preview divergence
switch = "!git giti switch"

# Fetch from all remotes and pull the latest changes into the current branch
sync = "!git giti sync"

# Soft-reset HEAD by one commit, leaving all changes staged
undo = "!git giti undo"

# Stage all changes and create a "wip" commit, bypassing hooks
wip = "!git giti wip"
